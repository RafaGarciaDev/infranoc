# InfraNOC - Exemplo de variaveis de ambiente do backend
# Copie este arquivo para ".env" (na pasta backend) e ajuste os valores.
# O prefixo INFRANOC_ e obrigatorio (definido em app/core/config.py).
# NUNCA comite o .env real (ja esta no .gitignore).

# --- Banco de dados (Postgres via docker-compose.dev.yml) ---
INFRANOC_DATABASE_URL=postgresql+asyncpg://infranoc:infranoc@localhost:5432/infranoc

# --- Redis ---
INFRANOC_REDIS_URL=redis://localhost:6379/0

# --- JWT ---
# Em producao, gere um segredo forte (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
INFRANOC_JWT_SECRET=troque-em-producao
INFRANOC_JWT_ALGORITHM=HS256
INFRANOC_ACCESS_EXPIRE_MIN=30
INFRANOC_REFRESH_EXPIRE_DAYS=7

# --- Active Directory (Fase 5) ---
# INFRANOC_AD_BIND_PASSWORD=
# INFRANOC_WINRM_PASSWORD=

# --- IA / Anthropic (Fase 7) ---
# INFRANOC_AI_API_KEY=
