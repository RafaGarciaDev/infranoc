# Postgres (usado pelo backend em container)
INFRANOC_DB_PASSWORD=troque-por-uma-senha-forte

# ITSM Peppermint (compose/docker-compose.itsm_peppermint.yml)
INFRANOC_PEPPERMINT_DB_PASSWORD=troque-por-uma-senha-forte
INFRANOC_PEPPERMINT_SECRET=troque-por-um-secret-forte

# ITSM Vikunja (compose/docker-compose.itsm_vikunja.yml)
INFRANOC_VIKUNJA_DB_PASSWORD=troque-por-uma-senha-forte
INFRANOC_VIKUNJA_SECRET=troque-por-um-secret-forte

# JWT (gerar com openssl rand -hex 32)
INFRANOC_JWT_SECRET=trocar-em-producao

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Grafana (compose/docker-compose.observability.yml)
INFRANOC_GRAFANA_ADMIN_USER=admin
INFRANOC_GRAFANA_ADMIN_PASSWORD=troque-em-producao
