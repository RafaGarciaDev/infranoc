# Postgres (usado pelo backend em container)
INFRANOC_DATABASE_URL=postgresql+asyncpg://infranoc:infranoc@postgres:5432/infranoc

# JWT (gerar com openssl rand -hex 32)
INFRANOC_JWT_SECRET=trocar-em-producao

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Grafana (compose/docker-compose.observability.yml)
INFRANOC_GRAFANA_ADMIN_USER=admin
INFRANOC_GRAFANA_ADMIN_PASSWORD=troque-em-producao
