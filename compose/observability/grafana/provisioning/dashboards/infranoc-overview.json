{
  "uid": "infranoc-overview",
  "title": "InfraNOC — Overview",
  "tags": ["infranoc", "phase3", "vale-verde"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ativos Monitorados",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus"},
      "targets": [{"expr": "count(infranoc_asset_up)", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "blue"}, "unit": "short"}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ativos Offline",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus"},
      "targets": [{"expr": "count(infranoc_asset_up == 0) or vector(0)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "OEE Medio",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus"},
      "targets": [{"expr": "avg(infranoc_oee_percent)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 60}, {"color": "green", "value": 75}]}}},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Alertas Ativos",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus"},
      "targets": [{"expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 3}]}}},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ativos Offline (historico)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus"},
      "targets": [{"expr": "count(infranoc_asset_up == 0) or vector(0)", "refId": "A", "legendFormat": "Offline"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "red"}, "custom": {"fillOpacity": 20, "lineWidth": 2}, "unit": "short"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "OEE por Linha de Producao",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus"},
      "targets": [{"expr": "infranoc_oee_percent", "refId": "A", "legendFormat": "{{line_name}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"lineWidth": 2, "fillOpacity": 10}}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Temperatura Camaras Frias (limite -15C)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus"},
      "targets": [{"expr": "infranoc_temp_celsius{asset=~\".*CF.*\"}", "refId": "A", "legendFormat": "{{asset}}"}],
      "fieldConfig": {"defaults": {"unit": "celsius", "custom": {"lineWidth": 2, "fillOpacity": 5}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}, {"color": "red", "value": -15}]}}}
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top 10 CPUs Mais Altos",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus"},
      "targets": [{"expr": "topk(10, infranoc_cpu_percent)", "refId": "A", "instant": true, "format": "table"}],
      "fieldConfig": {"defaults": {"unit": "percent", "custom": {"align": "left"}}}
    }
  ]
}